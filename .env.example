# ─── Configuración de sesame_auto ────────────────────────────────────────────
# Template para cada usuario. Copia a users/tu_usuario/.env y rellena.
# NUNCA subas .env a git.

# Credenciales de tu cuenta en panel.sesametime.com
SESAME_EMAIL=tu@email.com
SESAME_PASSWORD=tu_contrasena

# Zona horaria
TZ=Europe/Madrid

# Horas objetivo semanales
SESAME_TARGET_HOURS=40.0

# Rutas de ficheros (relativas a la carpeta del usuario)
SESAME_STATE=state.json
SESAME_HTTP_SESSION=http_session.json
SESAME_DEBUG=debug
SESAME_LOG=sesame_auto.log
SESAME_VACACIONES=vacaciones.txt

# Modo prueba: "true" simula los fichajes sin tocar nada en la web
SESAME_DRY_RUN=false

# ─── Sobrescritura de horarios (opcional) ─────────────────────────────────────
# Por defecto: entrada=9, comida salida=13, comida vuelta=14, salida=18
# Formato CSV: 5 valores (lunes, martes, miercoles, jueves, viernes)
# Solo hace falta descomentar las lineas que se quieran cambiar:
#
# CHECK_IN_1  = entrada mañana
# CHECK_OUT_1 = salida comida
# CHECK_IN_2  = vuelta comida
# CHECK_OUT_2 = salida final
#
SESAME_CHECK_IN_1_HOUR=9,9,10,9,9
#SESAME_CHECK_IN_1_MINUTE=0,0,0,0,0
#SESAME_CHECK_IN_1_JITTER=15,15,15,15,15
#
SESAME_CHECK_OUT_1_HOUR=13,13,13,13,13
#SESAME_CHECK_OUT_1_MINUTE=0,0,0,0,0
#SESAME_CHECK_OUT_1_JITTER=15,15,15,15,15
#
SESAME_CHECK_IN_2_HOUR=14,14,14,14,14
#SESAME_CHECK_IN_2_MINUTE=0,0,0,0,0
#SESAME_CHECK_IN_2_JITTER=15,15,15,15,15
#
SESAME_CHECK_OUT_2_HOUR=18,18,19,18,18
#SESAME_CHECK_OUT_2_MINUTE=0,0,0,0,0
#SESAME_CHECK_OUT_2_JITTER=15,15,15,15,15
