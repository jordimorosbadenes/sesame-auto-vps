# ─── Configuración de sesame_auto ────────────────────────────────────────────
# Template para cada usuario. Copia a users/tu_usuario/.env y rellena.
# NUNCA subas .env a git.

# Credenciales de tu cuenta en panel.sesametime.com
SESAME_EMAIL=tu@email.com
SESAME_PASSWORD=tu_contrasena

# Zona horaria
TZ=Europe/Madrid

# Horas objetivo semanales
SESAME_TARGET_HOURS=40.0

# Rutas de ficheros (relativas a la carpeta del usuario)
SESAME_STATE=state.json
SESAME_SESSION=browser_session.json
SESAME_SCREENSHOTS=screenshots
SESAME_LOG=sesame_auto.log
SESAME_VACACIONES=vacaciones.txt

# Modo headless del navegador (true = sin ventana, recomendado en VPS)
SESAME_HEADLESS=true

# Modo prueba: "true" simula los fichajes sin tocar nada en la web
SESAME_DRY_RUN=false
